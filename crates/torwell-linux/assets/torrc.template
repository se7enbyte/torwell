# Managed by torwell-linux. Regenerated on every start; do not edit.
DataDirectory /var/lib/torwell-tor
# IsolateDestAddr: different destination addresses never share a circuit, so one exit
# cannot link your traffic to different sites.
SocksPort 127.0.0.1:@SOCKS_PORT@ IsolateDestAddr
TransPort 127.0.0.1:@TRANS_PORT@ IsolateDestAddr
DNSPort 127.0.0.1:@DNS_PORT@
AutomapHostsOnResolve 1
VirtualAddrNetworkIPv4 10.192.0.0/10
ControlSocket @RUNTIME_DIR@/control
CookieAuthentication 1
CookieAuthFile @RUNTIME_DIR@/control.authcookie
CookieAuthFileGroupReadable 0
# Client only: never a relay, never an exit, no ORPort/DirPort.
ClientOnly 1
AvoidDiskWrites 1
SafeLogging 1
Log notice stderr
